# Cookies for scripts/scrape-local.sh. Copy to .env.local and fill in.
# .env.local is gitignored via macos/.gitignore (*.local pattern).
#
# How to get each value:
#   Chrome DevTools → Application → Cookies → <domain> → copy "Value" column.
#   For values shown with surrounding double quotes (JSESSIONID, bcookie, lidc, bscookie)
#   the quotes are part of the value — keep them in the env var.

# --- LinkedIn (required) ---
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# --- LinkedIn (optional, improves reliability) ---
LINKEDIN_BCOOKIE=
LINKEDIN_BSCOOKIE=
LINKEDIN_LIDC=
LINKEDIN_DFPFPT=

# --- X (required) ---
X_AUTH_TOKEN=
X_CT0=

# --- X (optional) ---
X_TWID=
X_KDT=

# --- Profile URLs (optional override; defaults in scrape-profiles.mjs) ---
# LINKEDIN_URL=https://www.linkedin.com/in/thomas-suen-84776a262/
# X_URL=https://x.com/ThomasSuen6
